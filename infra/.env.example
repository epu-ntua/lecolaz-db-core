
# ============================================================
# LeColaz - Docker Compose configuration
# Used by both infra/compose.yaml (LOCAL) and
# infra/compose.prod.yaml (PRODUCTION).
# ============================================================

# LOCAL: lecolaz-local
# PRODUCTION: lecolaz-prod
COMPOSE_PROJECT_NAME=lecolaz-local

# PostgreSQL
# Credentials must match backend/.env (POSTGRES_DSN).
POSTGRES_DB=lecolaz
POSTGRES_USER=lecolaz
POSTGRES_PASSWORD=lecolaz
POSTGRES_PORT=5432

# MinIO
# Credentials must match backend/.env.
MINIO_ROOT_USER=lecolaz
MINIO_ROOT_PASSWORD=lecolaz123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Fuseki
# Credentials and dataset must match backend/.env.
FUSEKI_ADMIN_PASSWORD=lecolaz
FUSEKI_DATASET=lecolaz
FUSEKI_PORT=3030

# Backend host port
# LOCAL: 8000
# PRODUCTION: 8080 (existing setup; review when moving to Caddy).
BACKEND_PORT=8000

# Production site-wide HTTP Basic Authentication
# Generate the password hash with Caddy; never put a plaintext password here.
# Keep the hash single-quoted so Docker Compose preserves its $ characters.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=

# Dagster - used in both environments
DAGSTER_IMAGE_NAME=lecolaz-dagster:1.13.23
DAGSTER_WEB_PORT=3000

# Dedicated Dagster database on the PostgreSQL service.
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# HAM sensor ingestion
# Required only when accessing HAM API data.
HAMAPI_API_KEY=

# Automated ingestion delay after UTC midnight (0-23 hours).
# Manual runs bypass this delay.
HAMAPI_INGESTION_DELAY_HOURS=4

# Public Enhydris ingestion (no API key required).
OPENMETEO_INGESTION_DELAY_HOURS=4
