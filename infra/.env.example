COMPOSE_PROJECT_NAME=lecolaz-local

POSTGRES_DB=lecolaz
POSTGRES_USER=lecolaz
POSTGRES_PASSWORD=lecolaz
POSTGRES_PORT=5432

MINIO_ROOT_USER=lecolaz
MINIO_ROOT_PASSWORD=lecolaz123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

BACKEND_PORT=8000

# Self-hosted Dagster (development only)
DAGSTER_IMAGE_NAME=lecolaz-dagster:1.13.21
DAGSTER_WEB_PORT=3000
# Dedicated database and non-superuser login on the existing postgres service.
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# Only needed when materializing HAM sensors or observation values
HAMAPI_API_KEY=

# Automation grace period after UTC midnight (whole hours, 0–23); manual runs bypass it.
HAMAPI_INGESTION_DELAY_HOURS=4
