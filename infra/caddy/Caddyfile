lecolaz.epu.ntua.gr {
    basic_auth argon2id {
        {env.BASIC_AUTH_USERNAME} {env.BASIC_AUTH_PASSWORD_HASH}
    }

    redir /portainer /portainer/ 308

    handle_path /portainer/* {
        reverse_proxy portainer:9000
    }

    handle_path /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
