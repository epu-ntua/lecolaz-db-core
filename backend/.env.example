
# ============================================================
# LeColaz - FastAPI configuration
# Used by both LOCAL and PRODUCTION backend containers.
# ============================================================

APP_NAME=LeColaz Platform

# LOCAL: dev
# PRODUCTION: prod
APP_ENV=dev

# Public API URL used in RDF time-series references.
# LOCAL: http://localhost:8000
# PRODUCTION: https://lecolaz.epu.ntua.gr/api
API_PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL
# Docker hostname stays the same in both environments.
# Credentials must match infra/.env.
POSTGRES_DSN=postgresql+psycopg://lecolaz:lecolaz@postgres:5432/lecolaz

# MinIO
# Internal Docker endpoint stays the same in both environments.
# Credentials must match infra/.env.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=lecolaz
MINIO_SECRET_KEY=lecolaz123
MINIO_BUCKET=lecolaz-data

# Fuseki
# Internal Docker endpoint stays the same in both environments.
FUSEKI_BASE_URL=http://fuseki:3030
FUSEKI_DATASET=lecolaz
FUSEKI_ADMIN_PASSWORD=lecolaz

# Dagster
# When backend runs inside Docker, use the service hostname.
# LOCAL and PRODUCTION: http://dagster-webserver:3000/graphql
# Direct backend execution on host: http://localhost:3000/graphql
DAGSTER_GRAPHQL_URL=http://dagster-webserver:3000/graphql
DAGSTER_CODE_LOCATION=lecolaz

# HAM API
# Normally supplied through infra/.env by Docker Compose.
# Set here when running FastAPI directly outside Docker.
HAMAPI_API_KEY=
