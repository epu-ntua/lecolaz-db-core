APP_NAME=LeColaz Platform
APP_ENV=dev
# Public URL written into leco:timeSeriesRef values in Fuseki.
# Development: FastAPI is available directly on localhost.
API_PUBLIC_BASE_URL=http://localhost:8000
# Production alternative: Nginx exposes FastAPI under /api/ on the public site.
