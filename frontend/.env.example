
# ============================================================
# LeColaz - Vite frontend configuration
# VITE_* variables are embedded during the frontend build.
# ============================================================

# API endpoint
# LOCAL: http://localhost:8000
# PRODUCTION: /api
#
# NOTE: Currently frontend/src/api/client.ts determines the
# API URL using import.meta.env.DEV, not this variable.
VITE_API_BASE_URL=http://localhost:8000

# Optional links shown in the administration interface.
# Set only when these interfaces are available.

# MinIO console
# LOCAL: http://localhost:9001
# PRODUCTION: leave empty unless publicly exposed.
VITE_MINIO_CONSOLE_URL=http://localhost:9001

# Dagster interface
# LOCAL: http://localhost:3000
# PRODUCTION: leave empty unless publicly exposed.
VITE_DAGSTER_URL=http://localhost:3000

# Portainer
# LOCAL: leave empty (not needed for development).
# PRODUCTION: /portainer/
VITE_PORTAINER_URL=
